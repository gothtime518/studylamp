# 环境变量配置示例
# 复制为 .env 并填入真实值，然后 source .env 或用 docker-compose 加载

# ── 大模型 ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── 微信小程序 ───────────────────────────────────────────────
WECHAT_APP_ID=your_wechat_appid
WECHAT_APP_SECRET=your_wechat_appsecret
WECHAT_TEMPLATE_ALERT=your_alert_template_id
WECHAT_TEMPLATE_DAILY=your_daily_template_id

# ── 数据库 ───────────────────────────────────────────────────
STUDYLAMP_DB=./studylamp.db

# ── 采集端 ───────────────────────────────────────────────────
STUDYLAMP_SERVER=http://localhost:8000
STUDYLAMP_DEVICE_ID=mac-dev-001
