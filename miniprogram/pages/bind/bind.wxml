<view class="container">
  <view class="page-title">绑定设备</view>
  <view class="hint">输入孩子昵称和设备 ID（在 Mac 端菜单栏查看）</view>

  <view class="card">
    <input
      class="input"
      placeholder="孩子昵称（如：小明）"
      value="{{inputName}}"
      bindinput="onInputName"
    />
    <input
      class="input"
      placeholder="设备 ID（如：mac-dev-001）"
      value="{{inputId}}"
      bindinput="onInputId"
    />
    <button
      class="btn btn-primary"
      bindtap="bind"
      disabled="{{!inputId || loading}}"
    >{{loading ? '验证中…' : '绑定'}}</button>
  </view>

  <view wx:if="{{error}}" class="error" style="padding:16rpx 0">{{error}}</view>
</view>
